<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntelliGrade.App.ViewModels"
             x:Class="IntelliGrade.App.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="welcomeView">

    <!-- Content -->
        <Grid Margin="40">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="600"
                        Spacing="48">

                <!-- Title -->
                <StackPanel Spacing="16">
                    <TextBlock Text="IntelliGrade"
                               Classes="welcome-title"
                               FontSize="64"
                               FontWeight="Bold"
                               TextAlignment="Center"/>

                    <TextBlock Text="AI-Powered Assignment Grading"
                               Classes="welcome-subtitle"
                               FontSize="24"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Feature Cards -->
                <Grid ColumnDefinitions="*,16,*,16,*">

                    <!-- Feature 1 -->
                    <Border Grid.Column="0" Classes="feature-card">
                        <TextBlock Text="Fast Execution"
                                   Classes="feature-title"
                                   TextAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Feature 2 -->
                    <Border Grid.Column="2" Classes="feature-card">
                        <TextBlock Text="AI Analysis"
                                   Classes="feature-title"
                                   TextAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Feature 3 -->
                    <Border Grid.Column="4" Classes="feature-card">
                        <TextBlock Text="Export Results"
                                   Classes="feature-title"
                                   TextAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Border>

                </Grid>

                <!-- Get Started Button -->
                <Button Content="Get Started"
                        Command="{Binding StartGradingCommand}"
                        Classes="primary"
                        Width="200"
                        Height="50"
                        HorizontalAlignment="Center"/>

            </StackPanel>
        </Grid>

</UserControl>
