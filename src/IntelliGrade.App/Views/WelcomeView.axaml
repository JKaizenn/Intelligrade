<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntelliGrade.App.ViewModels"
             x:Class="IntelliGrade.App.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="welcomeView">

    <!-- Content -->
        <Grid Margin="40">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="600"
                        Spacing="48">

                <!-- Title -->
                <StackPanel Spacing="16">
                    <TextBlock Text="IntelliGrade"
                               Classes="welcome-title"
                               FontSize="64"
                               FontWeight="Bold"
                               TextAlignment="Center"/>

                    <TextBlock Text="AI-Powered Assignment Grading"
                               Classes="welcome-subtitle"
                               FontSize="24"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Get Started Button -->
                <Button Content="Get Started"
                        Command="{Binding StartGradingCommand}"
                        Classes="primary"
                        Width="200"
                        Height="50"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </StackPanel>
        </Grid>

</UserControl>
