<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IntelliGrade.App.App"
             xmlns:local="using:IntelliGrade.App"
             RequestedThemeVariant="Default">
    <!-- 
        RequestedThemeVariant options:
        - "Default" = follows system theme
        - "Dark" = force dark mode
        - "Light" = force light mode
        
        Can be changed at runtime via:
        Application.Current.RequestedThemeVariant = ThemeVariant.Dark;
    -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <!-- Load theme color resources (must be in Resources, not Styles) -->
        <ResourceInclude Source="/Styles/Theme.axaml"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Only need one Styles file now - no more DarkTheme.axaml! -->
        <StyleInclude Source="/Styles/Styles.axaml"/>
    </Application.Styles>
</Application>