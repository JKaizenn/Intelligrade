<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Calibri, Helvetica Neue, Arial, sans-serif"/>
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
    </Style>

    <!-- Primary Button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}"/>
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressed}"/>
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonDisabled}"/>
    </Style>

    <!-- Secondary Button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SecondaryButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
    </Style>

    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonPressed}"/>
    </Style>

    <!-- Success Button -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessButtonHover}"/>
    </Style>

    <Style Selector="Button.success:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessButtonPressed}"/>
    </Style>

    <!-- Danger Button -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerButtonHover}"/>
    </Style>

    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerButtonPressed}"/>
    </Style>

    <!-- Icon Button -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource IconButtonBackgroundHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForegroundHover}"/>
    </Style>

    <Style Selector="Button.icon:pressed">
        <Setter Property="Background" Value="{DynamicResource IconButtonBackgroundPressed}"/>
    </Style>

    <!-- Border Card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Feature Card -->
    <Style Selector="Border.feature-card">
        <Setter Property="Background" Value="{DynamicResource FeatureCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FeatureCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.feature-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource FeatureCardBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FeatureCardBorderHover}"/>
    </Style>

    <!-- Header -->
    <Style Selector="Border.header">
        <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <!-- Status Bar -->
    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{DynamicResource StatusBarBackground}"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <!-- TextBlock Styles -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.subheading">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style Selector="TextBlock.on-dark">
        <Setter Property="Foreground" Value="{DynamicResource TextOnDark}"/>
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.description">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="TextBox.code">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="Background" Value="{DynamicResource CodeBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource CodeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CodeBorder}"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ComboBox -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- NumericUpDown -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="NumericUpDown:pointerover /template/ Border#BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
    </Style>

    <Style Selector="NumericUpDown:focus /template/ Border#BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
    </Style>

    <Style Selector="NumericUpDown:pointerover /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForegroundHover}"/>
    </Style>

    <Style Selector="NumericUpDown:pointerover /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Foreground" Value="{DynamicResource IconButtonForegroundHover}"/>
    </Style>

    <!-- TabControl -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TabText}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TabTextHover}"/>
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TabTextSelected}"/>
    </Style>

    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource TabTextSelected}"/>
    </Style>

    <!-- ScrollBar -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumb}"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pressed">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbPressed}"/>
    </Style>

    <!-- Message Border -->
    <Style Selector="Border.message-error">
        <Setter Property="Background" Value="{DynamicResource MessageErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MessageErrorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.message-info">
        <Setter Property="Background" Value="{DynamicResource MessageInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MessageInfoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Badge -->
    <Style Selector="Border.badge-success">
        <Setter Property="Background" Value="{DynamicResource BadgeSuccess}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.badge-error">
        <Setter Property="Background" Value="{DynamicResource BadgeError}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

</Styles>
