<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">

            <!-- Backgrounds -->
            <SolidColorBrush x:Key="WindowBackground">#e2e8f0</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBackground">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackground">#ffffff</SolidColorBrush>
            <SolidColorBrush x:Key="HeaderBackground">#ffffff</SolidColorBrush>
            <SolidColorBrush x:Key="HeaderBorder">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="StatusBarBackground">#f1f5f9</SolidColorBrush>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TextMuted">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="TextOnDark">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="TextOnAccent">#f8fafc</SolidColorBrush>

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderDefault">#e2e8f0</SolidColorBrush>
            <SolidColorBrush x:Key="BorderMuted">#cbd5e1</SolidColorBrush>
            <SolidColorBrush x:Key="BorderHover">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="BorderFocus">#3b82f6</SolidColorBrush>
            
            <!-- Inputs -->
            <SolidColorBrush x:Key="InputBackground">#ffffff</SolidColorBrush>
            <SolidColorBrush x:Key="InputBackgroundHover">#f1f5f9</SolidColorBrush>
            <SolidColorBrush x:Key="InputBackgroundFocus">#ffffff</SolidColorBrush>
            <SolidColorBrush x:Key="InputText">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="InputPlaceholder">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="InputBorder">#cbd5e1</SolidColorBrush>
            
            <!-- Code Editor -->
            <SolidColorBrush x:Key="CodeBackground">#ffffff</SolidColorBrush>
            <SolidColorBrush x:Key="CodeText">#1e293b</SolidColorBrush>
            <SolidColorBrush x:Key="CodeBorder">#cbd5e1</SolidColorBrush>
            
            <!-- Primary Button -->
            <SolidColorBrush x:Key="PrimaryButton">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonHover">#2563eb</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonPressed">#1d4ed8</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonDisabled">#94a3b8</SolidColorBrush>
            
            <!-- Secondary Button -->
            <SolidColorBrush x:Key="SecondaryButton">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryButtonHover">#334155</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryButtonPressed">#1e293b</SolidColorBrush>
            
            <!-- Success Button -->
            <SolidColorBrush x:Key="SuccessButton">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessButtonHover">#059669</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessButtonPressed">#047857</SolidColorBrush>
            
            <!-- Danger Button -->
            <SolidColorBrush x:Key="DangerButton">#ef4444</SolidColorBrush>
            <SolidColorBrush x:Key="DangerButtonHover">#dc2626</SolidColorBrush>
            <SolidColorBrush x:Key="DangerButtonPressed">#b91c1c</SolidColorBrush>
            
            <!-- Icon Button -->
            <SolidColorBrush x:Key="IconButtonBackground">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonBackgroundHover">#f1f5f9</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonBackgroundPressed">#e2e8f0</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonForeground">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonForegroundHover">#475569</SolidColorBrush>
            
            <!-- Feature Cards -->
            <SolidColorBrush x:Key="FeatureCardBackground">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBackgroundHover">#f1f5f9</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBorder">#e2e8f0</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBorderHover">#cbd5e1</SolidColorBrush>
            
            <!-- Tabs -->
            <SolidColorBrush x:Key="TabText">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="TabTextHover">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TabTextSelected">#3b82f6</SolidColorBrush>
            
            <!-- ScrollBar -->
            <SolidColorBrush x:Key="ScrollThumb">#cbd5e1</SolidColorBrush>
            <SolidColorBrush x:Key="ScrollThumbHover">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="ScrollThumbPressed">#64748b</SolidColorBrush>
            
            <!-- Messages -->
            <SolidColorBrush x:Key="MessageErrorBackground">#fef2f2</SolidColorBrush>
            <SolidColorBrush x:Key="MessageErrorBorder">#ef4444</SolidColorBrush>
            <SolidColorBrush x:Key="MessageErrorText">#dc2626</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoBackground">#eff6ff</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoBorder">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoText">#1e40af</SolidColorBrush>
            
            <!-- Badges -->
            <SolidColorBrush x:Key="BadgeSuccess">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeError">#ef4444</SolidColorBrush>
            
            <!-- Selection -->
            <SolidColorBrush x:Key="SelectionBackground">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionText">#ffffff</SolidColorBrush>
            
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">

            <!-- Backgrounds -->
            <SolidColorBrush x:Key="WindowBackground">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBackground">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackground">#1e293b</SolidColorBrush>
            <SolidColorBrush x:Key="HeaderBackground">#020617</SolidColorBrush>
            <SolidColorBrush x:Key="HeaderBorder">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="StatusBarBackground">#0f172a</SolidColorBrush>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">#cbd5e1</SolidColorBrush>
            <SolidColorBrush x:Key="TextMuted">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="TextOnDark">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="TextOnAccent">#f8fafc</SolidColorBrush>
            
            <!-- Borders -->
            <SolidColorBrush x:Key="BorderDefault">#334155</SolidColorBrush>
            <SolidColorBrush x:Key="BorderMuted">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="BorderHover">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="BorderFocus">#3b82f6</SolidColorBrush>
            
            <!-- Inputs -->
            <SolidColorBrush x:Key="InputBackground">#1e293b</SolidColorBrush>
            <SolidColorBrush x:Key="InputBackgroundHover">#334155</SolidColorBrush>
            <SolidColorBrush x:Key="InputBackgroundFocus">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="InputText">#f8fafc</SolidColorBrush>
            <SolidColorBrush x:Key="InputPlaceholder">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="InputBorder">#475569</SolidColorBrush>
            
            <!-- Code Editor -->
            <SolidColorBrush x:Key="CodeBackground">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="CodeText">#e2e8f0</SolidColorBrush>
            <SolidColorBrush x:Key="CodeBorder">#475569</SolidColorBrush>
            
            <!-- Primary Button -->
            <SolidColorBrush x:Key="PrimaryButton">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonHover">#2563eb</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonPressed">#1d4ed8</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryButtonDisabled">#475569</SolidColorBrush>
            
            <!-- Secondary Button -->
            <SolidColorBrush x:Key="SecondaryButton">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryButtonHover">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryButtonPressed">#334155</SolidColorBrush>
            
            <!-- Success Button -->
            <SolidColorBrush x:Key="SuccessButton">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessButtonHover">#059669</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessButtonPressed">#047857</SolidColorBrush>
            
            <!-- Danger Button -->
            <SolidColorBrush x:Key="DangerButton">#ef4444</SolidColorBrush>
            <SolidColorBrush x:Key="DangerButtonHover">#dc2626</SolidColorBrush>
            <SolidColorBrush x:Key="DangerButtonPressed">#b91c1c</SolidColorBrush>
            
            <!-- Icon Button -->
            <SolidColorBrush x:Key="IconButtonBackground">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonBackgroundHover">#1e293b</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonBackgroundPressed">#334155</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonForeground">#cbd5e1</SolidColorBrush>
            <SolidColorBrush x:Key="IconButtonForegroundHover">#f8fafc</SolidColorBrush>
            
            <!-- Feature Cards -->
            <SolidColorBrush x:Key="FeatureCardBackground">#0f172a</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBackgroundHover">#1e293b</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBorder">#334155</SolidColorBrush>
            <SolidColorBrush x:Key="FeatureCardBorderHover">#475569</SolidColorBrush>
            
            <!-- Tabs -->
            <SolidColorBrush x:Key="TabText">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="TabTextHover">#cbd5e1</SolidColorBrush>
            <SolidColorBrush x:Key="TabTextSelected">#3b82f6</SolidColorBrush>
            
            <!-- ScrollBar -->
            <SolidColorBrush x:Key="ScrollThumb">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="ScrollThumbHover">#64748b</SolidColorBrush>
            <SolidColorBrush x:Key="ScrollThumbPressed">#94a3b8</SolidColorBrush>
            
            <!-- Messages -->
            <SolidColorBrush x:Key="MessageErrorBackground">#450a0a</SolidColorBrush>
            <SolidColorBrush x:Key="MessageErrorBorder">#ef4444</SolidColorBrush>
            <SolidColorBrush x:Key="MessageErrorText">#fca5a5</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoBackground">#172554</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoBorder">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="MessageInfoText">#93c5fd</SolidColorBrush>
            
            <!-- Badges -->
            <SolidColorBrush x:Key="BadgeSuccess">#10b981</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeError">#ef4444</SolidColorBrush>
            
            <!-- Selection -->
            <SolidColorBrush x:Key="SelectionBackground">#3b82f6</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionText">#ffffff</SolidColorBrush>
            
        </ResourceDictionary>
        
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>