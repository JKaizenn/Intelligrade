<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IntelliGrade.App.ViewModels"
        xmlns:converters="using:IntelliGrade.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="IntelliGrade.App.Views.CourseManagementView"
        x:DataType="vm:CourseManagementViewModel"
        Title="Manage Courses"
        Width="600" Height="500"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:CourseManagementViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Course Management"
                       Classes="section-header"
                       FontSize="18"/>
            <TextBlock Text="Add or remove courses for organizing your rubrics"
                       Classes="description"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content with ScrollViewer for small screens -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,12,Auto,12,Auto" ColumnDefinitions="*,12,*" Margin="0,0,8,0">

                <!-- Add Course Section -->
                <Border Grid.Row="0" Grid.Column="0" Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Add New Course"
                                   Classes="label"
                                   FontSize="15"/>

                        <TextBox Text="{Binding NewCourseName}"
                                 Watermark="Enter course name (e.g., CSE 232)"
                                 MaxLength="50"/>

                        <TextBlock Text="Examples: CSE 232, MATH 101, CS 101"
                                   Classes="description"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <Button Content="Add Course"
                                Command="{Binding AddCourseCommand}"
                                Classes="primary"
                                HorizontalAlignment="Stretch"
                                MinHeight="36"/>

                        <!-- Error Message -->
                        <Border IsVisible="{Binding HasError}"
                                Background="#fef2f2"
                                BorderBrush="#ef4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#dc2626"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Existing Courses Section -->
                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,12,*,12,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="Existing Courses"
                                   Classes="label"
                                   FontSize="15"/>

                        <Border Grid.Row="2"
                                BorderBrush="#cbd5e1"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Courses}"
                                         SelectedItem="{Binding SelectedCourse}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Padding="8,6"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <Button Grid.Row="4"
                                Content="Delete Selected"
                                Command="{Binding DeleteCourseCommand}"
                                Classes="danger"
                                HorizontalAlignment="Stretch"
                                MinHeight="36"
                                IsEnabled="{Binding SelectedCourse, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                    </Grid>
                </Border>

                <!-- Info Section -->
                <Border Grid.Row="2" Grid.Column="0" Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Guidelines"
                                   Classes="label"
                                   FontSize="13"/>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                                • Use standard course codes (e.g., CSE 232)
                            </TextBlock>
                            <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                                • Avoid special characters (&lt;&gt;:/\|?*)
                            </TextBlock>
                            <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                                • Letters, numbers, spaces, hyphens allowed
                            </TextBlock>
                            <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                                • Cannot delete courses with existing rubrics
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rubric Manager Section -->
                <Border Grid.Row="4" Grid.ColumnSpan="3" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,12,*,12,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="Rubric Manager"
                                      Classes="label"
                                      FontSize="15"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                      Text="{Binding SelectedCourse, StringFormat='Course: {0}'}"
                                      Classes="description"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding SelectedCourse, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                        </Grid>

                        <!-- Rubrics List -->
                        <Border Grid.Row="2"
                               BorderBrush="#cbd5e1"
                               BorderThickness="1"
                               CornerRadius="6"
                               MinHeight="120"
                               MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Rubrics}"
                                        SelectedItem="{Binding SelectedRubric}"
                                        Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                      Padding="8,6"
                                                      FontSize="13"
                                                      TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <!-- Info Message when no course selected -->
                        <TextBlock Grid.Row="2"
                                  Text="Select a course above to view and manage its rubrics"
                                  Classes="description"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  IsVisible="{Binding SelectedCourse, Converter={x:Static converters:ObjectNullConverter.Instance}}"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  Margin="20"/>

                        <!-- Delete Rubric Button -->
                        <Button Grid.Row="4"
                               Content="Delete Selected Rubric"
                               Command="{Binding DeleteRubricCommand}"
                               Classes="danger"
                               HorizontalAlignment="Stretch"
                               MinHeight="36"
                               IsEnabled="{Binding SelectedRubric, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,24,0,0">
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Classes="secondary"
                    Width="100"/>
        </StackPanel>

    </Grid>

</Window>
