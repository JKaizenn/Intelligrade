<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IntelliGrade.App.Views.GitCloneDialog"
        Title="Clone GitHub Repository"
        Width="600" Height="250"
        MinWidth="500" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Clone GitHub Repository"
                       Classes="section-header"
                       FontSize="18"/>
            <TextBlock Text="Enter the GitHub repository URL to clone"
                       Classes="description"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Classes="card" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="Repository URL" Classes="label"/>
                <TextBox x:Name="RepoUrlTextBox"
                         Watermark="https://github.com/username/repository.git"
                         FontFamily="JetBrains Mono,Consolas,Menlo,Monaco,Courier New,monospace"
                         FontSize="13"/>
                <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                    Supported formats:
                    • https://github.com/username/repo.git
                    • https://github.com/username/repo
                    • git@github.com:username/repo.git
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,24,0,0">

            <Button Grid.Column="1"
                    Content="Clone"
                    Click="CloneButton_Click"
                    Classes="primary"
                    Width="100"
                    Margin="0,0,12,0"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Classes="secondary"
                    Width="100"/>

        </Grid>

    </Grid>

</Window>
