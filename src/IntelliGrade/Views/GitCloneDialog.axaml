<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IntelliGrade.App.Views.GitCloneDialog"
        Title="Clone GitHub Repository"
        Width="600" Height="380"
        MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,20,24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20" HorizontalAlignment="Center" MaxWidth="500">
            <TextBlock Text="Clone GitHub Repository"
                       Classes="section-header"
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Enter the GitHub repository URL to clone"
                       Classes="description"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Classes="card" Padding="20" MaxWidth="500" HorizontalAlignment="Center" Margin="0,0,0,20">
            <StackPanel Spacing="12">
                <TextBlock Text="Repository URL" Classes="label" FontSize="14"/>
                <TextBox x:Name="RepoUrlTextBox"
                         Watermark="https://github.com/username/repository.git"
                         FontFamily="JetBrains Mono,Consolas,Menlo,Monaco,Courier New,monospace"
                         FontSize="13"
                         HorizontalAlignment="Stretch"
                         MinWidth="400"
                         MinHeight="32"
                         KeyDown="RepoUrlTextBox_KeyDown"/>
                <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16">
                    Supported formats:
                    <LineBreak/>• https://github.com/username/repo.git
                    <LineBreak/>• https://github.com/username/repo
                    <LineBreak/>• git@github.com:username/repo.git
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" MaxWidth="500" HorizontalAlignment="Center">

            <Button Grid.Column="1"
                    Content="Clone"
                    Click="CloneButton_Click"
                    Classes="primary"
                    FontSize="13"
                    Width="120"
                    MinHeight="36"
                    Margin="0,0,12,0"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Classes="secondary"
                    FontSize="13"
                    Width="100"
                    MinHeight="36"/>

        </Grid>

    </Grid>

</Window>
