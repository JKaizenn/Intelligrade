<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntelliGrade.App.ViewModels"
             x:Class="IntelliGrade.App.Views.GradingView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="Auto,*" Margin="16">

        <!-- Left Panel: Configuration -->
        <Border Grid.Column="0"
                Classes="card"
                Width="356"
                Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="16">

                    <!-- Directory Selection -->
                    <StackPanel>
                        <TextBlock Text="Working Directory" Classes="label"/>
                        <TextBox Text="{Binding CurrentDirectory}"
                                 IsReadOnly="True"
                                 Watermark="No directory selected"
                                 Margin="0,0,0,10"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Select Directory"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Classes="primary"/>
                            <Button Grid.Column="2"
                                    Content="Clone Git Repo"
                                    Command="{Binding CloneGitRepositoryCommand}"
                                    Classes="secondary"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Management Buttons -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Management" Classes="label"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Manage Courses"
                                    Command="{Binding ManageCoursesCommand}"
                                    Classes="secondary"/>
                            <Button Grid.Column="2"
                                    Content="Import Rubric"
                                    Command="{Binding ImportRubricCommand}"
                                    Classes="secondary"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Course Selection -->
                    <StackPanel>
                        <TextBlock Text="Course" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  PlaceholderText="Select course..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Language Selection -->
                    <StackPanel>
                        <TextBlock Text="Programming Language" Classes="label"/>
                        <ComboBox ItemsSource="{Binding DetectedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  PlaceholderText="Detect languages..."
                                  HorizontalAlignment="Stretch"/>
                        <Button Content="Detect Languages"
                                Command="{Binding DetectLanguagesCommand}"
                                Margin="0,8,0,0"
                                Classes="secondary"/>
                    </StackPanel>

                    <!-- Source File Selection -->
                    <StackPanel>
                        <TextBlock Text="Source File" Classes="label"/>
                        <ComboBox ItemsSource="{Binding SourceFiles}"
                                  SelectedItem="{Binding SelectedSourceFile}"
                                  PlaceholderText="Select source file..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Assignment Selection -->
                    <StackPanel>
                        <TextBlock Text="Assignment" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Assignments}"
                                  SelectedItem="{Binding SelectedAssignment}"
                                  PlaceholderText="Select assignment..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Separator/>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Actions" Classes="label"/>

                        <Button Content="Run Program"
                                Command="{Binding RunProgramCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="primary"/>

                        <Button Content="Analyze with AI"
                                Command="{Binding AnalyzeCodeCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="secondary"/>

                        <Button Content="Cleanup Files"
                                Command="{Binding CleanupFilesCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="danger"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel: Content Tabs -->
        <Border Grid.Column="1"
                Classes="card"
                Margin="8,0,0,0">
            <TabControl>

                <!-- Source Code Tab -->
                <TabItem Header="Source Code">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding SourceCode}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Program Output Tab -->
                <TabItem Header="Output">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding ProgramOutput}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Rubric Tab -->
                <TabItem Header="Rubric">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding RubricContent}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- AI Analysis Tab -->
                <TabItem Header="AI Analysis">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding AiAnalysis}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Grading Tab -->
                <TabItem Header="Grading">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" MaxWidth="800" Margin="16">

                            <!-- Student Info -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Student Information" Classes="label" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,16,*">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding StudentName}"
                                                 Watermark="Student Name"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding StudentId}"
                                                 Watermark="Student ID (optional)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Grading Summary Header -->
                            <Border Classes="card" Padding="16" Background="{DynamicResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LetterGrade}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="Current Grade"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,24,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="28" FontWeight="SemiBold">
                                            <Run Text="{Binding Grade}"/>
                                            <Run Text="/" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="100" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="Total Points"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Percentage"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Simple Grade Entry -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Grade Entry" Classes="label" FontSize="16"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="Score (0-100):"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding Grade}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       FormatString="F0"
                                                       HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Overall Feedback -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Instructor Feedback" Classes="label" FontSize="16"/>
                                    <TextBox Text="{Binding InstructorFeedback}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="150"
                                             Watermark="Enter overall feedback for the student..."/>
                                </StackPanel>
                            </Border>

                            <!-- Export Actions -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Export Results" Classes="label" FontSize="16"/>
                                    <Grid ColumnDefinitions="*,12,*">
                                        <Button Grid.Column="0"
                                                Content="Save as JSON"
                                                Command="{Binding ExportJsonCommand}"
                                                Classes="primary"/>
                                        <Button Grid.Column="2"
                                                Content="Save as CSV"
                                                Command="{Binding ExportCsvCommand}"
                                                Classes="success"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Bottom spacer to ensure export section is visible -->
                            <Panel Height="20"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>

</UserControl>
