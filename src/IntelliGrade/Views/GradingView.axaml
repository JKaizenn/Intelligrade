<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntelliGrade.App.ViewModels"
             x:Class="IntelliGrade.App.Views.GradingView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="Auto,*" Margin="16">

        <!-- Left Panel: Configuration -->
        <Border Grid.Column="0"
                Classes="card"
                Width="356"
                Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2">
                    <StackPanel Spacing="16" Margin="0,0,16,0">

                    <!-- Directory Selection -->
                    <StackPanel>
                        <TextBlock Text="Working Directory" Classes="label"/>
                        <TextBox Text="{Binding CurrentDirectory}"
                                 IsReadOnly="True"
                                 Watermark="No directory selected"
                                 Margin="0,0,0,10"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Select Directory"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Classes="primary"/>
                            <Button Grid.Column="2"
                                    Content="Clone Git Repo"
                                    Command="{Binding CloneGitRepositoryCommand}"
                                    Classes="secondary"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Management Buttons -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Management" Classes="label"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Manage Courses"
                                    Command="{Binding ManageCoursesCommand}"
                                    Classes="secondary"
                                    Padding="8,10"/>
                            <Button Grid.Column="2"
                                    Content="Import Rubric"
                                    Command="{Binding ImportRubricCommand}"
                                    Classes="secondary"
                                    Padding="8,10"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Course Selection -->
                    <StackPanel>
                        <TextBlock Text="Course" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  PlaceholderText="Select course..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Language Detection -->
                    <StackPanel>
                        <TextBlock Text="Programming Language" Classes="label"/>
                        <ComboBox ItemsSource="{Binding DetectedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  PlaceholderText="Detect languages..."
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Detect Languages"
                                Command="{Binding DetectLanguagesCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Source File Selection -->
                    <StackPanel>
                        <TextBlock Text="Source File" Classes="label"/>
                        <ComboBox ItemsSource="{Binding SourceFiles}"
                                  SelectedItem="{Binding SelectedSourceFile}"
                                  PlaceholderText="Select source file..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Assignment Selection -->
                    <StackPanel>
                        <TextBlock Text="Assignment" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Assignments}"
                                  SelectedItem="{Binding SelectedAssignment}"
                                  PlaceholderText="Select assignment..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Separator/>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Actions" Classes="label"/>

                        <Button Content="Run Program"
                                Command="{Binding RunProgramCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="primary"/>

                        <Button Content="Analyze with AI"
                                Command="{Binding AnalyzeCodeCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="secondary"/>

                        <Button Content="Cleanup Files"
                                Command="{Binding CleanupFilesCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="danger"/>
                    </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Panel: Content Tabs -->
        <Border Grid.Column="1"
                Classes="card"
                Margin="8,0,0,0">
            <TabControl>

                <!-- Source Code Tab -->
                <TabItem Header="Source Code">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding SourceCode}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Program Output Tab -->
                <TabItem Header="Output">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding ProgramOutput}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Rubric Tab -->
                <TabItem Header="Rubric">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding RubricContent}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- AI Analysis Tab -->
                <TabItem Header="AI Analysis">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding AiAnalysis}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Grading Tab -->
                <TabItem Header="Grading">
                    <ScrollViewer Padding="16">
                        <StackPanel Spacing="20" MaxWidth="800">

                            <!-- Student Info -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Student Information" Classes="label" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,16,*">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding StudentName}"
                                                 Watermark="Student Name"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding StudentId}"
                                                 Watermark="Student ID (optional)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Grading Summary Header -->
                            <Border Classes="card" Padding="16" Background="{DynamicResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LetterGrade}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="Current Grade"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,24,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="28" FontWeight="SemiBold">
                                            <Run Text="{Binding Grade}"/>
                                            <Run Text="/" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="100" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="Total Points"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Percentage"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AI Assistance Actions -->
                            <Border Classes="card" Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="AI Grading Assistance" FontWeight="SemiBold"/>
                                        <TextBlock Text="Review AI suggestions below and adjust as needed"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Apply All AI Suggestions"
                                            Classes="secondary"
                                            Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Criteria Grading (Placeholder for now) -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Per-Criterion Grading"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Per-criterion grading interface will be integrated here when GradingSessionViewModel is connected."
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"/>

                                    <!-- Example Criterion Template -->
                                    <Border Classes="card" Padding="12" Background="{DynamicResource Surface}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Example Criterion Name"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="/ 50 pts"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Grid>

                                            <!-- AI Suggestion -->
                                            <Border Background="{DynamicResource InputBackground}"
                                                    Padding="12"
                                                    CornerRadius="4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0"
                                                            Width="12"
                                                            Height="12"
                                                            CornerRadius="6"
                                                            Background="#10b981"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="AI Suggestion: 45/50"/>
                                                            <Run Text="(High Confidence)"
                                                                 FontSize="11"
                                                                 Foreground="#10b981"/>
                                                        </TextBlock>
                                                        <TextBlock Text="Reasoning: Example reasoning from AI analysis"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Score Input -->
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Your Score:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <NumericUpDown Grid.Column="1"
                                                               Minimum="0"
                                                               Maximum="50"
                                                               Value="45"
                                                               HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="2"
                                                        Content="Apply AI"
                                                        Classes="secondary"
                                                        Padding="8,4"
                                                        Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Separator/>

                            <!-- Overall Feedback -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Overall Instructor Feedback" Classes="label" FontSize="16"/>
                                    <TextBox Text="{Binding InstructorFeedback}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="150"
                                             Watermark="Enter overall feedback for the student..."/>
                                </StackPanel>
                            </Border>

                            <!-- Export Actions -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Export Results" Classes="label" FontSize="16"/>
                                    <Grid ColumnDefinitions="*,12,*">
                                        <Button Grid.Column="0"
                                                Content="Save as JSON"
                                                Command="{Binding ExportJsonCommand}"
                                                Classes="primary"/>
                                        <Button Grid.Column="2"
                                                Content="Save as CSV"
                                                Command="{Binding ExportCsvCommand}"
                                                Classes="success"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>

</UserControl>
