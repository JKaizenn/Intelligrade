<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntelliGrade.App.ViewModels"
             xmlns:converters="using:IntelliGrade.App.Converters"
             x:Class="IntelliGrade.App.Views.GradingView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="Auto,*" Margin="16">

        <!-- Left Panel: Configuration -->
        <Border Grid.Column="0"
                Classes="card"
                Width="356"
                Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="16">

                    <!-- Directory Selection -->
                    <StackPanel>
                        <TextBlock Text="Working Directory" Classes="label"/>
                        <TextBox Text="{Binding CurrentDirectory}"
                                 IsReadOnly="True"
                                 Watermark="No directory selected"
                                 Margin="0,0,0,10"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Select Directory"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Classes="primary"/>
                            <Button Grid.Column="2"
                                    Content="Clone Git Repo"
                                    Command="{Binding CloneGitRepositoryCommand}"
                                    Classes="secondary"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Management Buttons -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Management" Classes="label"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="Manage Courses"
                                    Command="{Binding ManageCoursesCommand}"
                                    Classes="secondary"/>
                            <Button Grid.Column="2"
                                    Content="Import Rubric"
                                    Command="{Binding ImportRubricCommand}"
                                    Classes="secondary"/>
                        </Grid>
                    </StackPanel>

                    <Separator/>

                    <!-- Course Selection -->
                    <StackPanel>
                        <TextBlock Text="Course" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  PlaceholderText="Select course..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Language Selection -->
                    <StackPanel>
                        <TextBlock Text="Programming Language" Classes="label"/>
                        <ComboBox ItemsSource="{Binding DetectedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  PlaceholderText="Detect languages..."
                                  HorizontalAlignment="Stretch"/>
                        <Button Content="Detect Languages"
                                Command="{Binding DetectLanguagesCommand}"
                                Margin="0,8,0,0"
                                Classes="secondary"/>
                    </StackPanel>

                    <!-- Source File Selection -->
                    <StackPanel>
                        <TextBlock Text="Source File" Classes="label"/>
                        <ComboBox ItemsSource="{Binding SourceFiles}"
                                  SelectedItem="{Binding SelectedSourceFile}"
                                  PlaceholderText="Select source file..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Assignment Selection -->
                    <StackPanel>
                        <TextBlock Text="Assignment" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Assignments}"
                                  SelectedItem="{Binding SelectedAssignment}"
                                  PlaceholderText="Select assignment..."
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Separator/>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Actions" Classes="label"/>

                        <Button Content="Run Program"
                                Command="{Binding RunProgramCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="primary"/>

                        <Button Content="Analyze with AI"
                                Command="{Binding AnalyzeCodeCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="secondary"/>

                        <Button Content="Cleanup Files"
                                Command="{Binding CleanupFilesCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="danger"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel: Content Tabs -->
        <Border Grid.Column="1"
                Classes="card"
                Margin="8,0,0,0">
            <TabControl>

                <!-- Source Code Tab -->
                <TabItem Header="Source Code">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding SourceCode}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Program Output Tab -->
                <TabItem Header="Output">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding ProgramOutput}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Rubric Tab -->
                <TabItem Header="Rubric">
                    <ScrollViewer Padding="16">
                        <TextBox Text="{Binding RubricContent}" Classes="code"/>
                    </ScrollViewer>
                </TabItem>

                <!-- AI Analysis Tab -->
                <TabItem Header="AI Analysis">
                    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Rubric-Based Analysis -->
                            <TextBox Text="{Binding AiAnalysis}" Classes="code"/>

                            <!-- Code Quality Analysis Button -->
                            <Border Classes="card" Padding="16" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Advanced Code Quality Analysis" FontWeight="SemiBold"/>
                                        <TextBlock Text="Analyze complexity, bugs, security issues, and code smells"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Analyze Code Quality"
                                            Command="{Binding AnalyzeCodeQualityCommand}"
                                            IsEnabled="{Binding !IsProcessing}"
                                            Classes="secondary"
                                            Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Advanced Analysis Results -->
                            <Border Classes="card" Padding="16"
                                    IsVisible="{Binding AdvancedAnalysis, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Code Quality Report" FontSize="16" FontWeight="SemiBold"/>

                                    <!-- Complexity -->
                                    <Border Background="{DynamicResource InputBackground}" Padding="12" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="Cyclomatic Complexity: "/>
                                                <Run Text="{Binding AdvancedAnalysis.CyclomaticComplexity}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding AdvancedAnalysis.ComplexityRating}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                                Low: 1-10 | Medium: 11-20 | High: 21+
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Potential Bugs -->
                                    <Expander Header="{Binding AdvancedAnalysis.PotentialBugs.Count, StringFormat='Potential Bugs ({0})'}"
                                              IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding AdvancedAnalysis.PotentialBugs}" Margin="8,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Surface}"
                                                            Padding="12"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Category}"
                                                                           FontWeight="SemiBold"/>
                                                                <Border Grid.Column="2"
                                                                        Background="{DynamicResource ErrorBackground}"
                                                                        CornerRadius="3"
                                                                        Padding="6,2">
                                                                    <TextBlock Text="{Binding Severity}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource ErrorForeground}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13"/>
                                                            <TextBlock Text="{Binding LineReference}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       IsVisible="{Binding LineReference, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource AccentColor}"
                                                                       IsVisible="{Binding Suggestion, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                                                <Run Text="Suggestion: "/>
                                                                <Run Text="{Binding Suggestion}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Security Issues -->
                                    <Expander Header="{Binding AdvancedAnalysis.SecurityIssues.Count, StringFormat='Security Issues ({0})'}"
                                              IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding AdvancedAnalysis.SecurityIssues}" Margin="8,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Surface}"
                                                            Padding="12"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Category}"
                                                                           FontWeight="SemiBold"/>
                                                                <Border Grid.Column="2"
                                                                        Background="{DynamicResource ErrorBackground}"
                                                                        CornerRadius="3"
                                                                        Padding="6,2">
                                                                    <TextBlock Text="{Binding Severity}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource ErrorForeground}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13"/>
                                                            <TextBlock Text="{Binding LineReference}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       IsVisible="{Binding LineReference, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource AccentColor}"
                                                                       IsVisible="{Binding Suggestion, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                                                <Run Text="Suggestion: "/>
                                                                <Run Text="{Binding Suggestion}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Code Smells -->
                                    <Expander Header="{Binding AdvancedAnalysis.CodeSmells.Count, StringFormat='Code Smells ({0})'}"
                                              IsExpanded="False">
                                        <ItemsControl ItemsSource="{Binding AdvancedAnalysis.CodeSmells}" Margin="8,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Surface}"
                                                            Padding="12"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Category}"
                                                                           FontWeight="SemiBold"/>
                                                                <Border Grid.Column="2"
                                                                        Background="{DynamicResource InputBackground}"
                                                                        CornerRadius="3"
                                                                        Padding="6,2">
                                                                    <TextBlock Text="{Binding Severity}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13"/>
                                                            <TextBlock Text="{Binding LineReference}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       IsVisible="{Binding LineReference, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource AccentColor}"
                                                                       IsVisible="{Binding Suggestion, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                                                <Run Text="Suggestion: "/>
                                                                <Run Text="{Binding Suggestion}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Grading Tab -->
                <TabItem Header="Grading">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" MaxWidth="800" Margin="16">

                            <!-- Student Info -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Student Information" Classes="label" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,16,*">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding StudentName}"
                                                 Watermark="Student Name"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding StudentId}"
                                                 Watermark="Student ID (optional)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Grading Summary Header -->
                            <Border Classes="card" Padding="16" Background="{DynamicResource CardBackgroundAlt}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LetterGrade}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="Current Grade"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,24,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="28" FontWeight="SemiBold">
                                            <Run Text="{Binding Grade}"/>
                                            <Run Text="/" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="100" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="Total Points"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Percentage"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AI Assistance Actions -->
                            <Border Classes="card" Padding="16" IsVisible="{Binding GradingSession, Converter={x:Static converters:ObjectNullConverter.Instance}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="AI Grading Assistance" FontWeight="SemiBold"/>
                                        <TextBlock Text="Run AI Analysis to get per-criterion suggestions"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Analyze with AI"
                                            Command="{Binding AnalyzeCodeCommand}"
                                            Classes="primary"
                                            Padding="16,8"/>
                                </Grid>
                            </Border>

                            <!-- Per-Criterion Grading -->
                            <Border Classes="card" Padding="16" IsVisible="{Binding GradingSession, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Per-Criterion Grading"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <Button Grid.Column="1"
                                                Content="Apply All AI Suggestions"
                                                Command="{Binding GradingSession.ApplyAllAiSuggestionsCommand}"
                                                Classes="secondary"
                                                Padding="12,6"/>
                                    </Grid>

                                    <!-- Criteria List -->
                                    <ItemsControl ItemsSource="{Binding GradingSession.CriteriaGrades}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="card" Padding="12" Background="{DynamicResource Surface}" Margin="0,0,0,12">
                                                    <StackPanel Spacing="8">
                                                        <!-- Criterion Header -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Criterion.Name}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Foreground="{DynamicResource TextSecondary}">
                                                                <Run Text="/"/><Run Text="{Binding Criterion.MaxPoints}"/><Run Text=" pts"/>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- AI Suggestion -->
                                                        <Border Background="{DynamicResource InputBackground}"
                                                                Padding="12"
                                                                CornerRadius="4"
                                                                IsVisible="{Binding AiSuggestion, Converter={x:Static converters:ObjectNotNullConverter.Instance}}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- Confidence Indicator Dot -->
                                                                <Border Grid.Column="0"
                                                                        Width="12"
                                                                        Height="12"
                                                                        CornerRadius="6"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,0">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding AiSuggestion.Confidence, Converter={x:Static converters:ConfidenceColorConverter.Instance}}"/>
                                                                    </Border.Background>
                                                                </Border>

                                                                <!-- AI Suggestion Details -->
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock FontWeight="SemiBold">
                                                                        <Run Text="AI Suggestion: "/>
                                                                        <Run Text="{Binding AiSuggestion.SuggestedScore}"/>
                                                                        <Run Text="/"/>
                                                                        <Run Text="{Binding AiSuggestion.MaxPoints}"/>
                                                                        <Run Text=" (" FontSize="11"/>
                                                                        <Run Text="{Binding AiSuggestion.Confidence}" FontSize="11"/>
                                                                        <Run Text=" Confidence)" FontSize="11"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding AiSuggestion.Reasoning}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                                </StackPanel>

                                                                <!-- Apply AI Button -->
                                                                <Button Grid.Column="2"
                                                                        Content="Apply"
                                                                        Command="{Binding ApplyAiCommand}"
                                                                        Classes="secondary"
                                                                        Padding="8,4"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Top"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Instructor Score Input -->
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Your Score:"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <NumericUpDown Grid.Column="1"
                                                                           Value="{Binding InstructorScore}"
                                                                           Minimum="0"
                                                                           Maximum="{Binding Criterion.MaxPoints}"
                                                                           Increment="1"
                                                                           FormatString="F0"
                                                                           HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Overall Feedback -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Instructor Feedback" Classes="label" FontSize="16"/>
                                    <TextBox Text="{Binding InstructorFeedback}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="150"
                                             Watermark="Enter overall feedback for the student..."/>
                                </StackPanel>
                            </Border>

                            <!-- Export Actions -->
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Export Results" Classes="label" FontSize="16"/>
                                    <Grid ColumnDefinitions="*,12,*">
                                        <Button Grid.Column="0"
                                                Content="Save as JSON"
                                                Command="{Binding ExportJsonCommand}"
                                                Classes="primary"/>
                                        <Button Grid.Column="2"
                                                Content="Save as CSV"
                                                Command="{Binding ExportCsvCommand}"
                                                Classes="success"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Bottom spacer to ensure export section is visible -->
                            <Panel Height="20"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>

</UserControl>
