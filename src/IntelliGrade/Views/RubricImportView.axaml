<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IntelliGrade.App.ViewModels"
        xmlns:converters="using:IntelliGrade.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
        x:Class="IntelliGrade.App.Views.RubricImportView"
        x:DataType="vm:RubricImportViewModel"
        Title="Import Rubric"
        Width="800" Height="700"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:RubricImportViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="32,24,32,24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20" MaxWidth="700" HorizontalAlignment="Center">
            <TextBlock Text="Import Rubric"
                       Classes="section-header"/>
            <TextBlock Text="Add a new grading rubric from text or file. The program will automatically convert it to JSON format."
                       Classes="description"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" MaxWidth="700" HorizontalAlignment="Center" Margin="0,0,0,20">

                <!-- Course and Language Selection -->
                <Border Classes="card" Padding="20" MaxWidth="700">
                    <Grid RowDefinitions="Auto,12,Auto,12,Auto" ColumnDefinitions="*,16,*">

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="Rubric Information"
                                   Classes="label"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                        <!-- Course Selection -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Course" Classes="label"/>
                            <ComboBox ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse}"
                                      PlaceholderText="Select course..."
                                      HorizontalAlignment="Stretch"
                                      MinWidth="200"/>
                        </StackPanel>

                        <!-- Language Selection -->
                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                            <TextBlock Text="Programming Language" Classes="label"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      PlaceholderText="Select language..."
                                      HorizontalAlignment="Stretch"
                                      MinWidth="200"/>
                        </StackPanel>

                        <!-- Assignment Name -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock Text="Assignment Name" Classes="label"/>
                            <TextBox Text="{Binding AssignmentName}"
                                     Watermark="e.g., W06 Lab - Binary Tree"
                                     MaxLength="100"
                                     HorizontalAlignment="Stretch"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Rubric Content -->
                <Border Classes="card" Padding="20" MaxWidth="700">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Rubric Content"
                                       Classes="label"
                                       FontSize="16"/>

                            <Button Grid.Column="1"
                                    Content="Load from File"
                                    Command="{Binding ImportFromFileCommand}"
                                    Classes="secondary"
                                    Padding="16,8"
                                    FontSize="13"/>
                        </Grid>

                        <TextBox Text="{Binding RubricText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="200"
                                 MaxHeight="300"
                                 Watermark="Paste or type your rubric here, or use 'Load from File' button..."
                                 FontFamily="JetBrains Mono,Consolas,Menlo,Monaco,Courier New,monospace"
                                 FontSize="13"
                                 HorizontalAlignment="Stretch"/>

                        <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap">
                            Tip: The program works best with rubrics that clearly list criteria and point values.
                            Example: "Code Quality (35 pts): Excellent (35 pts), Good (28 pts), Fair (21 pts)"
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Conversion Options -->
                <Border Classes="card" Padding="20" MaxWidth="700">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Conversion Options"
                                   Classes="label"
                                   FontSize="16"/>

                        <CheckBox IsChecked="{Binding ConvertToJson}"
                                  Content="Convert to JSON format (recommended)"
                                  FontSize="14"/>

                        <TextBlock Classes="description" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                            JSON format enables better AI grading and structured analysis. The program will use
                            pattern-based conversion to parse the rubric structure.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Error/Status Messages -->
                <Border IsVisible="{Binding HasError}"
                        Classes="message-error">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"/>
                </Border>

                <Border IsVisible="{Binding IsProcessing}"
                        Classes="message-info">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Status and Buttons -->
        <Grid Grid.Row="2" Margin="0,24,0,0" MaxWidth="700" HorizontalAlignment="Center" RowDefinitions="Auto,12,Auto">

            <!-- Status Message Row -->
            <Border Grid.Row="0"
                    IsVisible="{Binding !IsProcessing}"
                    Background="{DynamicResource CardBackgroundAlt}"
                    Padding="12,8"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="{DynamicResource AccentColor}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static converters:ObjectNotNullConverter.Instance}}"/>
            </Border>

            <!-- Buttons Row -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1"
                        Content="Save Rubric"
                        Command="{Binding SaveRubricCommand}"
                        Classes="primary"
                        FontSize="13"
                        Width="120"
                        MinHeight="36"
                        Margin="0,0,12,0"
                        IsEnabled="{Binding !IsProcessing}"/>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Classes="secondary"
                        FontSize="13"
                        Width="100"
                        MinHeight="36"
                        IsEnabled="{Binding !IsProcessing}"/>
            </Grid>
        </Grid>

    </Grid>

</Window>
